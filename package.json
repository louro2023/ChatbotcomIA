{
  "name": "cchatbot",
  "version": "1.0.9",
  "description": "TurboWhats - atendimento inteligente para WhatsApp",
  "author": "Henrique Louro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louro2023/ChatbotcomIA.git"
  },
  "bugs": {
    "url": "https://github.com/louro2023/ChatbotcomIA/issues"
  },
  "homepage": "https://github.com/louro2023/ChatbotcomIA#readme",
  "main": "Electron/main.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "check": "node --check Electron/main.js && node --check Electron/preload.js && node --check Electron/renderer.js && node --check scripts/run-electron.js && node --check scripts/prepare-browser.js && node --check scripts/prepare-brand-assets.mjs",
    "smoke": "node scripts/run-electron.js --smoke-test",
    "prepare:brand": "node scripts/prepare-brand-assets.mjs",
    "prepare:browser": "node scripts/prepare-browser.js",
    "pack:win": "npm run check && npm run prepare:brand && npm run prepare:browser && electron-builder --win dir --x64",
    "build:win": "npm run check && npm run prepare:brand && npm run prepare:browser && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "build": {
    "appId": "com.henriquelouro.turbowhats",
    "productName": "TurboWhats",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "Electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build-cache/browser",
        "to": "browser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": ".build-cache/turbowhats.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TurboWhats-Portable-${version}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "splashImage": ".build-cache/turbowhats-splash.bmp"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
